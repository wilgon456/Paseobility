{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skillNload catalog item v2",
  "type": "object",
  "required": ["catalog_id", "kind", "name", "description", "added_at", "source", "archive", "verification", "risk", "activation_policy", "acquisition"],
  "properties": {
    "catalog_id": {"type": "string", "minLength": 3},
    "kind": {"enum": ["skill", "plugin", "template", "source-pointer"]},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "added_at": {"type": "string", "format": "date-time"},
    "source_id": {"type": "string"},
    "source": {"$ref": "#/$defs/source"},
    "archive": {"$ref": "#/$defs/archive"},
    "verification": {"$ref": "#/$defs/verification"},
    "security_policy": {"$ref": "security-policy-v1.json"},
    "acquisition": {"$ref": "#/$defs/acquisition"},
    "trust": {"type": "object"},
    "risk": {"enum": ["instructions-only", "local-management", "scripts", "external-write", "destructive"]},
    "activation_policy": {"enum": ["default", "on-demand", "manual", "blocked"]},
    "compatibility": {"type": "array", "items": {"type": "string"}},
    "oses": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["repository", "commit", "path", "url"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "license": {
      "type": "object",
      "required": ["declared", "redistribution"],
      "properties": {
        "declared": {"type": "string", "minLength": 1},
        "redistribution": {"enum": ["permitted-with-notice", "permitted-by-root-license", "not-affirmatively-verified", "unknown", "forbidden"]}
      }
    },
    "archive": {
      "type": "object",
      "required": ["status", "path", "license"],
      "properties": {
        "status": {"enum": ["archived", "metadata-only", "blocked", "deprecated"]},
        "path": {"type": ["string", "null"]},
        "blocker": {"type": ["string", "null"]},
        "license": {"$ref": "#/$defs/license"}
      }
    },
    "verification": {
      "type": "object",
      "required": ["status", "source_commit"],
      "properties": {
        "status": {"type": "string"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "acquisition": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "method": {"enum": ["packaged", "git-sparse"]},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "expected_checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "repository": {"type": "string"},
        "subdirectory": {"type": "string"},
        "path": {"type": "string"},
        "reason": {"type": "string"},
        "license_gate": {"$ref": "#/$defs/license"}
      }
    }
  }
}
